{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".npmrc"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_PRODUCT_NAME", "DATA_SOURCE", "ALLOW_MOCK_DATA", "EXPO_PUBLIC_DATA_SOURCE"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
