# -----------------------------------------------------------------------------
# Copier ce fichier en `.env.local` (dashboard) et `.env` (mobile), puis remplir.
# Aucune valeur secrete ne doit etre commitee.
# -----------------------------------------------------------------------------

# --- Produit -----------------------------------------------------------------
# Nom commercial affiche dans le dashboard. Repli : PRODUCT_NAME_FALLBACK
# exporte par @app/shared.
NEXT_PUBLIC_PRODUCT_NAME=

# --- Source de donnees -------------------------------------------------------
# mock : donnees fictives en memoire (lots 01 a 10).
# supabase : backend reel (a partir du lot 14).
# En production (next start, Vercel, Docker), DATA_SOURCE est obligatoire et le mock
# est refuse, sauf ALLOW_MOCK_DATA=1 (demo, tests E2E) : voir apps/dashboard/src/lib/data-source.ts.
DATA_SOURCE=mock
ALLOW_MOCK_DATA=
EXPO_PUBLIC_DATA_SOURCE=mock

# --- Supabase (lot 11 et suivants) -------------------------------------------
# Projet region Paris (eu-west-3). La cle service_role ne doit JAMAIS etre
# exposee au client ni commitee.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adresse publique du dashboard (liens des emails d'invitation et de reinitialisation).
NEXT_PUBLIC_SITE_URL=
# Cle service : UNIQUEMENT pour les scripts d'exploitation (scripts/*.ts) et les
# Edge Functions. Le dashboard ne la lit jamais.
SUPABASE_SERVICE_ROLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Commune de l'app mobile (une app par commune) ; demo-alpha par defaut.
EXPO_PUBLIC_TENANT_SLUG=

# --- Cartes (lot 09 et suivants) ---------------------------------------------
# Style MapTiler. Ne jamais utiliser tile.openstreetmap.org en production
# (voir docs/decisions.md, ADR-005).
NEXT_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_URL=

# --- Supervision (lot 19) -----------------------------------------------------
# Sentry, projet en region UE (DSN en *.ingest.de.sentry.io). Vide : Sentry desactive.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Envoi des source maps au build (CI / Vercel uniquement, jamais commite).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
