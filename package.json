{
  "name": "mairie",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:start": "supabase start -x logflare,vector,imgproxy,edge-runtime,supavisor",
    "db:stop": "supabase stop",
    "db:generate": "tsx scripts/db/generate-sql.ts",
    "db:reset": "supabase db reset",
    "db:seed": "tsx scripts/seed-local.ts",
    "db:types": "supabase gen types typescript --local --schema public > packages/data/src/supabase/database.types.ts && prettier --write packages/data/src/supabase/database.types.ts",
    "db:lint": "supabase db lint --schema public,private --level warning --fail-on error",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@app/data": "workspace:*",
    "@app/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "postgres": "^3.4.9",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "tsx": "^4.23.15",
    "turbo": "2.11.4",
    "typescript": "5.9.3"
  }
}
